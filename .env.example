# A3DIA - Variables d'environnement (exemple)
# Copier vers .env pour le dev local. NE JAMAIS commiter le vrai .env.
# Sur Vercel : configurer dans Project Settings > Environment Variables.

# ---- Email ----
# Mot de passe SMTP du compte contact@a3dia-info.org (Hostinger)
SMTP_PASS=

# ---- Auth (JWT) ----
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ---- Admin initial (utilisé UNE SEULE FOIS pour POST /api/admin/setup) ----
ADMIN_EMAIL=admin@a3dia-info.org
ADMIN_PASSWORD=

# ---- Vercel KV (Redis) ----
# Obtenir depuis : Vercel Dashboard > Storage > Create KV Store > votre projet
# Ces variables sont injectées automatiquement si vous liez le store dans Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
